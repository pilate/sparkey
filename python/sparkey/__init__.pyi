import os
from collections.abc import Iterable, Iterator, Mapping
from typing import TypeVar, final, overload

__version__: str
__all__ = [
    "Compression",
    "HashIterator",
    "HashReader",
    "HashWriter",
    "IterState",
    "IterType",
    "LogIter",
    "LogReader",
    "LogWriter",
    "SparkeyException",
    "writehash",
]

_Path = str | bytes | os.PathLike[str] | os.PathLike[bytes]
_Data = bytes | str | bytearray | memoryview
_T = TypeVar("_T")

class Compression:
    NONE: int
    SNAPPY: int
    ZSTD: int

class IterState:
    NEW: int
    ACTIVE: int
    CLOSED: int
    INVALID: int

class IterType:
    PUT: int
    DELETE: int

class SparkeyException(Exception):
    code: int | None

def writehash(hashfile: _Path, logfile: _Path | None = None, hash_size: int = 0) -> None: ...

class LogWriter:
    def __init__(
        self,
        filename: _Path,
        mode: str = "NEW",
        compression_type: int = 0,
        compression_block_size: int = 0,
    ) -> None: ...
    @property
    def closed(self) -> bool: ...
    def put(self, key: _Data, value: _Data) -> None: ...
    def delete(self, key: _Data) -> None: ...
    def update(self, items: Mapping[_Data, _Data] | Iterable[tuple[_Data, _Data]], /) -> None: ...
    def flush(self) -> None: ...
    def close(self) -> None: ...
    def __setitem__(self, key: _Data, value: _Data, /) -> None: ...
    def __delitem__(self, key: _Data, /) -> None: ...
    def __enter__(self: _T) -> _T: ...
    def __exit__(self, *args: object) -> bool: ...

class HashWriter(LogWriter):
    def __init__(
        self,
        hashfile: _Path,
        logfile: _Path | None = None,
        mode: str = "NEW",
        compression_type: int = 0,
        compression_block_size: int = 0,
        hash_size: int = 0,
    ) -> None: ...
    def put(self, k: _Data, v: _Data) -> None: ...
    def delete(self, k: _Data) -> None: ...
    def finish(self) -> None: ...
    def destroy(self) -> None: ...
    @overload
    def get(self, key: _Data) -> bytes | None: ...
    @overload
    def get(self, key: _Data, default: _T) -> bytes | _T: ...
    def getAsString(self, key: _Data) -> str | None: ...
    def iteritems(self) -> HashIterator: ...
    def __getitem__(self, key: _Data, /) -> bytes | None: ...
    def __contains__(self, key: object, /) -> bool: ...
    def __iter__(self) -> HashIterator: ...

class LogReader:
    def __init__(self, filename: _Path) -> None: ...
    @property
    def closed(self) -> bool: ...
    def close(self) -> None: ...
    def __iter__(self) -> LogIter: ...
    def __enter__(self: _T) -> _T: ...
    def __exit__(self, *args: object) -> bool: ...

@final
class LogIter(Iterator[tuple[bytes, bytes, int]]):
    def __new__(cls, logreader: LogReader) -> LogIter: ...
    def __next__(self) -> tuple[bytes, bytes, int]: ...
    def close(self) -> None: ...

class HashReader:
    def __init__(self, hashfile: _Path, logfile: _Path | None = None) -> None: ...
    @property
    def closed(self) -> bool: ...
    @overload
    def get(self, key: _Data) -> bytes | None: ...
    @overload
    def get(self, key: _Data, default: _T) -> bytes | _T: ...
    def getAsString(self, key: _Data) -> str | None: ...
    @overload
    def get_many(self, keys: Iterable[_Data]) -> list[bytes | None]: ...
    @overload
    def get_many(self, keys: Iterable[_Data], default: _T) -> list[bytes | _T]: ...
    def has_key(self, key: _Data) -> bool: ...
    def iteritems(self) -> HashIterator: ...
    def items(self) -> HashIterator: ...
    def keys(self) -> Iterator[bytes]: ...
    def values(self) -> Iterator[bytes]: ...
    def close(self) -> None: ...
    def __getitem__(self, key: _Data, /) -> bytes: ...
    def __contains__(self, key: object, /) -> bool: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> HashIterator: ...
    def __enter__(self: _T) -> _T: ...
    def __exit__(self, *args: object) -> bool: ...

@final
class HashIterator(Iterator[tuple[bytes, bytes]]):
    def __new__(cls, hashreader: HashReader) -> HashIterator: ...
    def __next__(self) -> tuple[bytes, bytes]: ...
    def close(self) -> None: ...
