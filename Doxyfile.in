# Doxygen configuration for Sparkey. Only settings that differ from Doxygen's
# defaults are listed; run "doxygen -g" to see the full set of options.

PROJECT_NAME           = Sparkey
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "A simple key value store"
OUTPUT_DIRECTORY       = doxy
ABBREVIATE_BRIEF       =
FULL_PATH_NAMES        = NO
TAB_SIZE               = 8
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = YES
HIDE_UNDOC_MEMBERS     = YES
CASE_SENSE_NAMES       = YES
INPUT                  = @PROJECT_SOURCE_DIR@/src
FILE_PATTERNS          = *.h
EXAMPLE_PATTERNS       =
SOURCE_BROWSER         = YES
GENERATE_TREEVIEW      = NO
HAVE_DOT               = NO
